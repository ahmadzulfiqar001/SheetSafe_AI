# SheetSafe AI — Production Environment Configuration Template
# COPY TO .env.production OR SET AS ENVIRONMENT VARIABLES.
# NEVER COMMIT REAL SECRETS, API KEYS, OR PRODUCTION CREDENTIALS TO VERSION CONTROL.

# 1. Environment & Docs Mode (Fail-Closed)
# Production strictly rejects insecure local cookies and synthetic planning.
SHEETSAFE_ENVIRONMENT=production
SHEETSAFE_DOCS_ENABLED=false

# 2. Database & Busy Timeout
# SQLite database path must be outside the web root and on local POSIX storage with WAL mode.
SHEETSAFE_DATABASE_PATH=var/sheetsafe_prod.sqlite3
SHEETSAFE_DATABASE_BUSY_TIMEOUT_MS=5000

# 3. Private Encrypted Storage
# Dedicated private directory with restrictive filesystem permissions (0700).
# Never point this at public, static, or container-shared roots.
SHEETSAFE_PRIVATE_STORAGE_PATH=var/storage_prod

# 4. Strict Origin Allowlist (MANDATORY IN PRODUCTION)
# Production requires an explicit, non-empty list of exact HTTPS origins.
# Empty allowlist fails closed on startup. Example: ["https://sheetsafe.example.com"]
SHEETSAFE_ALLOWED_ORIGINS=["https://sheetsafe.example.com"]

# 5. Cookie Security Settings
# Insecure local cookies MUST remain false in production. Setting true raises ConfigurationError.
SHEETSAFE_ALLOW_INSECURE_LOCAL_COOKIES=false

# 6. Session Lifetimes & Admission Limits
SHEETSAFE_SESSION_LIFETIME_SECONDS=3600
SHEETSAFE_SESSION_CREATIONS_PER_IP_PER_MINUTE=5
SHEETSAFE_SESSION_CREATIONS_GLOBAL_PER_MINUTE=60
SHEETSAFE_MAX_SESSION_RECORDS=5000

# 7. Asynchronous Retention & Cleanup Worker
# Strict 5-minute physical cleanup target window.
SHEETSAFE_CLEANUP_INTERVAL_SECONDS=10
SHEETSAFE_CLEANUP_BATCH_SIZE=50
SHEETSAFE_CLEANUP_RETENTION_BATCH_SIZE=500
SHEETSAFE_CLEANUP_MAX_ATTEMPTS=5
SHEETSAFE_CLEANUP_ADAPTER_TIMEOUT_SECONDS=2

# 8. Vultr Serverless Inference Client
# Official endpoint is https://api.vultrinference.com/v1.
# Provide the production Vultr API key via secure environment variable only.
# SHEETSAFE_VULTR_INFERENCE_API_KEY=
SHEETSAFE_VULTR_INFERENCE_MODEL=llama2-13b-chat
SHEETSAFE_VULTR_INFERENCE_CONNECT_TIMEOUT_SECONDS=5.0
SHEETSAFE_VULTR_INFERENCE_READ_TIMEOUT_SECONDS=20.0
SHEETSAFE_VULTR_INFERENCE_MAX_REQUEST_BYTES=32768
SHEETSAFE_VULTR_INFERENCE_MAX_RESPONSE_BYTES=65536
SHEETSAFE_VULTR_INFERENCE_MAX_INPUT_TOKENS=4096
SHEETSAFE_VULTR_INFERENCE_MAX_OUTPUT_TOKENS=1024
SHEETSAFE_VULTR_INFERENCE_MAX_RETRIES=1

# 9. Synthetic Planning Guard (FORBIDDEN IN PRODUCTION)
# Synthetic demonstration planning is locked in production. Setting true raises ConfigurationError.
SHEETSAFE_SYNTHETIC_PLANNING_ENABLED=false
SHEETSAFE_PLANNING_REQUESTS_PER_SESSION_PER_MINUTE=10
SHEETSAFE_MAX_RUNS_PER_SESSION=25

