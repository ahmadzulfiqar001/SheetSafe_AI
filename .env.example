# Copy to .env.local for local use. Never place real secrets in this example.
# Precedence: process environment > .env.local > .env > defaults.
SHEETSAFE_ENVIRONMENT=development
# Enable only when local interactive API documentation is needed.
SHEETSAFE_DOCS_ENABLED=false
# Relative paths are resolved from the project root. Keep storage private.
SHEETSAFE_DATABASE_PATH=var/sheetsafe.sqlite3
SHEETSAFE_DATABASE_BUSY_TIMEOUT_MS=5000
# Optional dedicated private directory; default is beside the DB, under storage/.
# Never point this at user files, a sandbox mount, or a public/static directory.
# SHEETSAFE_PRIVATE_STORAGE_PATH=var/storage
# At-rest encryption/OS access-control verification blocks real uploads; synthetic only.
# No origins are trusted by default. Production must list exact HTTPS origins.
# Local example: ["http://localhost:8000","http://localhost:8501"]
SHEETSAFE_ALLOWED_ORIGINS=[]
# Opt in ONLY for local HTTP development with loopback-only origins.
# Production/test configurations reject this setting when true.
SHEETSAFE_ALLOW_INSECURE_LOCAL_COOKIES=false
SHEETSAFE_SESSION_LIFETIME_SECONDS=3600
SHEETSAFE_SESSION_CREATIONS_PER_IP_PER_MINUTE=5
SHEETSAFE_SESSION_CREATIONS_GLOBAL_PER_MINUTE=60
SHEETSAFE_MAX_SESSION_RECORDS=1000
# Bounded session retention worker; five-minute cleanup deadline is fixed policy.
SHEETSAFE_CLEANUP_INTERVAL_SECONDS=10
SHEETSAFE_CLEANUP_BATCH_SIZE=50
SHEETSAFE_CLEANUP_RETENTION_BATCH_SIZE=500
SHEETSAFE_CLEANUP_MAX_ATTEMPTS=5
SHEETSAFE_CLEANUP_ADAPTER_TIMEOUT_SECONDS=2
